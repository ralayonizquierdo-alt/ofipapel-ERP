rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cualquier sesión autenticada (incluida la anónima que abre la propia app
    // nada más cargar) puede leer y escribir. El filtro real de acceso es la
    // pantalla de contraseña compartida delante de la app, no esta regla —
    // mismo modelo que el resto de apps de este ecosistema (ver README.md).
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
