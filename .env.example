# Copia este archivo como .env.local (no se sube a git) y rellena los valores.
# En producción (GitHub Actions) estos mismos valores van como "Secrets" del repositorio.

# Contraseña compartida de acceso a la app (pantalla de bloqueo inicial)
VITE_APP_PASSWORD=

# Config del proyecto Firebase (Configuración del proyecto → General → tus apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
